# PostgreSQL — local usa el contenedor de docker-compose, en prod usa Neon
DATABASE_URL="postgresql://sansur:sansur@localhost:5432/sansur_erp?schema=public"

# API
API_PORT=4000
JWT_SECRET="cambia-esto-en-produccion-please"
JWT_EXPIRES_IN="8h"

# CORS — acepta multiples origenes separados por coma. Util para previews de Vercel.
# Ej: "https://sansur-erp.vercel.app,https://sansur-erp-git-main-eduvent.vercel.app"
CORS_ORIGIN="http://localhost:3000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"

# OpenAI — GPT-4o-mini para function calling (modulo IA)
OPENAI_API_KEY=""

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
# IDs de Telegram autorizados (separados por coma, vacio = todos pueden usar el bot)
TELEGRAM_ALLOWED_IDS=""
