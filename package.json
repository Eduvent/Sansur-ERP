{
  "name": "sansur-erp",
  "version": "0.1.0",
  "private": true,
  "description": "ERP Sansur — Sistema de gestión de inventario de ventiladores con módulo de IA via Telegram",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@sansur/api",
    "dev:web": "npm run dev --workspace=@sansur/web",
    "dev:bot": "npm run dev --workspace=@sansur/telegram-bot",
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run generate --workspace=@sansur/database",
    "db:migrate": "npm run migrate --workspace=@sansur/database",
    "db:seed": "npm run seed --workspace=@sansur/database",
    "db:studio": "npm run studio --workspace=@sansur/database"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
